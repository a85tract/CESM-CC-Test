#!/usr/bin/env bash
# CC-Test's pre-push hook is the engine's (RecastEngine tools/pre-push): the
# range-per-ref logic that was here moved there with the gate, step 9d of
# docs/CORRECTNESS-ORGANIZATION.md. What stays here is the choice of recipe --
# audit-cesm, with the LLM audit plane, for a repository that opted into the
# AI audit; audit otherwise (tools/engine.sh) -- and the report location, if
# HPC_DEVSECOPS_AUDIT_ROOT was configured. Existing installs are symlinks to
# this file; nothing has to be reinstalled.
#
# Git supplies:
#   argv:  remote-name remote-url
#   stdin: local-ref local-sha remote-ref remote-sha
# Exit codes are the engine's: 2 incomplete, 1 findings, 0 clean.

set -uo pipefail

HOOK_SOURCE="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
CC_TEST="${HPC_DEVSECOPS_HOME:-$(cd "$(dirname "$HOOK_SOURCE")/.." && pwd)}"
# shellcheck source=tools/engine.sh
. "$CC_TEST/tools/engine.sh"

REPO="$(git rev-parse --show-toplevel)" || exit 2
home="$(recast_home)" || exit 2
recipe="$(audit_recipe "$REPO")" || exit 2
export RECAST_AUDIT_RECIPE="$recipe"
if [ -n "${HPC_DEVSECOPS_AUDIT_ROOT:-}" ]; then
  export RECAST_AUDIT_ROOT="${RECAST_AUDIT_ROOT:-$HPC_DEVSECOPS_AUDIT_ROOT}"
fi
exec "$home/tools/pre-push" "$@"
