#!/usr/bin/env bash
# Fail-closed pre-push hook. Git supplies:
#   argv: remote-name remote-url
#   stdin: local-ref local-sha remote-ref remote-sha

set -uo pipefail

REMOTE_NAME="${1:-origin}"
REPO="$(git rev-parse --show-toplevel)" || exit 2
HOOK_SOURCE="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
TOOL_HOME="${HPC_DEVSECOPS_HOME:-$(cd "$(dirname "$HOOK_SOURCE")/.." && pwd)}"
RUNNER="$TOOL_HOME/tools/devsecops-local.sh"
ZERO=0000000000000000000000000000000000000000

if [ ! -x "$RUNNER" ]; then
  echo "hpc-devsecops: runner not found at $RUNNER — blocking push" >&2
  echo "Set HPC_DEVSECOPS_HOME or reinstall the hook." >&2
  exit 2
fi

checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue  # deletion: no new content
  checked=1

  if [ "$remote_sha" != "$ZERO" ]; then
    range="$remote_sha..$local_sha"
  else
    remote_head="refs/remotes/$REMOTE_NAME/HEAD"
    base="$(git merge-base "$local_sha" "$remote_head" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      range="$base..$local_sha"
    else
      empty_tree="$(git hash-object -t tree /dev/null)"
      range="$empty_tree..$local_sha"
    fi
  fi

  echo "hpc-devsecops: checking $local_ref → $remote_ref ($range)"
  "$RUNNER" --range "$range" --block "$REPO"
  rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"
done

[ "$checked" -eq 1 ] || echo "hpc-devsecops: no content-producing refs in this push"
exit 0
